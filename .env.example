# Core storage and retrieval
ACE_DB_URL=sqlite:///ace.db
ACE_EMBEDDINGS=bge-small
ACE_RETRIEVAL_TOPK=24
ACE_RETRIEVAL_LEXICAL_WEIGHT=0.5
ACE_RETRIEVAL_MAX_BULLETS=2000

# Refine and training
ACE_REFINE_THRESHOLD=0.90
ACE_REFINE_MINHASH_THRESHOLD=0.85
ACE_TRAINING_GATE_ON_REGRESSION=false
ACE_TRAINING_MAX_REGRESSION_DELTA=0.05
ACE_TRAINING_HELD_OUT_PATH=
ACE_TRAINING_REGRESSION_METRICS=mrr,recall

# Logging and transport
ACE_LOG_LEVEL=INFO
ACE_LOG_FORMAT=json
MCP_TRANSPORT=stdio
MCP_PORT=8000

# Reflector behavior
ACE_REFLECTOR_PASSES=1
ACE_REFLECTOR_SIMILARITY_THRESHOLD=0.85
ACE_REFLECTOR_REFINEMENT_ROUNDS=1
ACE_REFLECTOR_QUALITY_THRESHOLD=0.7

# LLM defaults
# Set ACE_LLM_PROVIDER=mock for local testing without network calls.
ACE_LLM_PROVIDER=openrouter
ACE_LLM_MODEL=openai/gpt-4o-mini
ACE_LLM_TEMPERATURE=0.0
ACE_LLM_MAX_TOKENS=2000
OPENROUTER_API_KEY=
